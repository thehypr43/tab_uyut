{
  "manifest_version": 3,
  "name": "Sekme Uyut",
  "version": "1.0",
  "description": "Sekmeleri secip RAM'den bosaltarak uyutur. Tiklayinca geri yuklenir.",
  "permissions": ["tabs", "tabGroups"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sekme Uyut"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
